seg_cols   <- c("EDAD1", "SEXO1", "ACT1", "PARCO1")
# Data loading ----
epa <- load_microdata(data_path,
cols  = columnas_seleccionadas,
types = tipos_columnas)
# AOI ----
aoi        <- count_aoi(epa, FACTOR, segment_cols = seg_cols)
aoi_g  <- group_aoi(aoi)
View(aoi_g)
rm(aoi_g)
View(aoi)
str(aoi)
id_cols <- setdiff(names(aoi), c("AOI", "TOTAL"))
formula_dcast <- as.formula(paste(paste(id_cols, collapse = " + "), "~ AOI"))
aoi_wide <- dcast(
aoi,
formula_dcast,
value.var = "TOTAL",
fill = 0,
value.name = "AOI_COD_"
)
View(aoi_wide)
if ("AOI_COD_NA" %in% names(aoi_wide)) {
# Ya tiene el nombre correcto
} else if ("AOI_COD_V1" %in% names(aoi_wide) && is.na(levels(aoi$AOI)[1])) {
# A veces data.table lo nombra diferente según el tipo de dato, nos aseguramos:
setnames(aoi_wide, "AOI_COD_NA", "AOI_COD_NA", skip_absent = TRUE)
}
aoi_wide[, `:=`(
OCUPADOS  = AOI_COD_3 + AOI_COD_4,
PARADOS   = AOI_COD_5 + AOI_COD_6,
INACTIVOS = AOI_COD_7 + AOI_COD_8 + AOI_COD_9,
MENORES   = AOI_COD_NA
)][, `:=`(
ACTIVOS   = OCUPADOS + PARADOS
)][, `:=`(
PET       = ACTIVOS + INACTIVOS
)][, `:=`(
POB       = MENORES + PET
)]
